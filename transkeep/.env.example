# Chép file này thành .env rồi điền vào. Dòng nào để trống cũng được.

# Mật khẩu vào app — NÊN đặt, để người lạ có link không dùng ké chìa khóa dịch của bạn
APP_PASSWORD=

# Chìa khóa máy dịch (điền ít nhất 1 cái, hoặc nhập trực tiếp trên web)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Tùy chọn nâng cao
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=50
KEEP_HOURS=24
